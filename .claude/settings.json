{
  "permissions": {
    "allow": [
      "Bash(playwright-cli open --headed https://test-prompt.mysys.com.au*)",
      "Bash(playwright-cli open --headed \"https://test-prompt.mysys.com.au*)",
      "Bash(playwright-cli snapshot*)",
      "Bash(playwright-cli screenshot*)",
      "Bash(playwright-cli find *)",
      "Bash(playwright-cli generate-locator *)",
      "Bash(playwright-cli tab-list)",
      "Bash(playwright-cli list)",
      "Bash(playwright-cli close)",
      "Bash(uv run scripts/check.py)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv sync --locked)",
      "Bash(uv run po-agent *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(playwright-cli click*)",
      "Bash(playwright-cli dblclick*)",
      "Bash(playwright-cli fill*)",
      "Bash(playwright-cli type*)",
      "Bash(playwright-cli drag*)",
      "Bash(playwright-cli drop*)",
      "Bash(playwright-cli hover*)",
      "Bash(playwright-cli select*)",
      "Bash(playwright-cli upload*)",
      "Bash(playwright-cli check*)",
      "Bash(playwright-cli uncheck*)",
      "Bash(playwright-cli eval*)",
      "Bash(playwright-cli run-code*)",
      "Bash(playwright-cli dialog-accept*)",
      "Bash(playwright-cli dialog-dismiss*)",
      "Bash(playwright-cli press*)",
      "Bash(playwright-cli keydown*)",
      "Bash(playwright-cli keyup*)",
      "Bash(playwright-cli mousemove*)",
      "Bash(playwright-cli mousedown*)",
      "Bash(playwright-cli mouseup*)",
      "Bash(playwright-cli mousewheel*)",
      "Bash(playwright-cli goto*)",
      "Bash(playwright-cli go-back*)",
      "Bash(playwright-cli go-forward*)",
      "Bash(playwright-cli reload*)",
      "Bash(playwright-cli state-save*)",
      "Bash(playwright-cli state-load*)",
      "Bash(playwright-cli cookie-*)",
      "Bash(playwright-cli localstorage-*)",
      "Bash(playwright-cli sessionstorage-*)",
      "Bash(playwright-cli route*)",
      "Bash(playwright-cli unroute*)",
      "Bash(playwright-cli requests*)",
      "Bash(playwright-cli request*)",
      "Bash(playwright-cli tracing-*)",
      "Bash(playwright-cli video-*)",
      "Bash(playwright-cli attach*)",
      "Bash(playwright-cli delete-data*)",
      "Bash(playwright-cli tab-new*)",
      "Bash(playwright-cli -s*)",
      "Bash(playwright-cli open --persistent*)",
      "Bash(playwright-cli open --profile*)",
      "Bash(npx playwright-cli*)",
      "Bash(npx @playwright/cli*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./config/live*.toml)",
      "Read(./state/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_paths.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
